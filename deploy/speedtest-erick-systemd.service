[Unit]
Description=Speedtest Flask Web App (User Service)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/erick/speedtest_web
ExecStart=/home/erick/speedtest_web/venv/bin/gunicorn -w 1 --threads 4 -b 127.0.0.1:7878 --timeout 120 speedtest_app:app
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
